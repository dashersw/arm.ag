---
import { Image } from 'astro:assets'
import { render, type CollectionEntry } from 'astro:content'
import Base from '../../layouts/Base.astro'
import { allProjects, allTalks, fmtDate } from '../../lib/site'

export async function getStaticPaths() {
  return (await allProjects()).map(project => ({ params: { id: project.id }, props: { project } }))
}
interface Props {
  project: CollectionEntry<'projects'>
}
const { project } = Astro.props
const p = project.data
const { Content } = await render(project)
const talks = p.repo ? (await allTalks()).filter(t => t.data.code?.some(c => c.toLowerCase().endsWith('/' + p.repo!.toLowerCase()))) : []
---

<Base title={p.title} description={p.tagline} image={p.cover}>
  <article>
    <header class="post-head narrow">
      <span class="meta"><a href="/projects/">Project</a> · since {p.year}{p.stars && ` · ${p.stars} GitHub stars`}</span>
      <h1>{p.title}</h1>
      <p class="sub">{p.tagline}</p>
      <div class="actions">
        {p.url && <a class="btn primary" href={p.url}>{new URL(p.url).hostname}</a>}
        {p.repo && <a class="btn" href={`https://github.com/${p.repo}`}>GitHub</a>}
      </div>
    </header>
    {
      p.cover && (
        <div class="post-cover">
          <Image src={p.cover} alt="" width={1920} loading="eager" />
        </div>
      )
    }
    <div class="prose narrow">
      <Content />
    </div>
    {
      talks.length > 0 && (
        <footer class="post-foot narrow">
          <h2>Talks about {p.title}</h2>
          <ul class="ledger">
            {talks.map(t => (
              <li>
                <span class="meta">{fmtDate(t.data.date)}</span>
                <a class="t" href={`/talks/${t.id}/`}>
                  {t.data.title}
                </a>
                <span class="where">{t.data.event}</span>
              </li>
            ))}
          </ul>
        </footer>
      )
    }
  </article>
</Base>
